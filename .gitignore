
# ============================================================
# CUSTOMER CHURN & RETENTION ANALYTICS
# Python 3.13.5 | Data Science | Streamlit
# ============================================================

# Python virtual environments
.venv/
venv/
env/
ENV/

# Python compiled files
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.so

# Build and packaging
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Testing and coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
junit.xml
test-results/

# Type checking and linting
.mypy_cache/
.pyright/
.ruff_cache/
.dmypy.json

# Jupyter
.ipynb_checkpoints/
*.nbconvert.ipynb

# IDE and operating system
.vscode/
.idea/
*.code-workspace
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo

# Environment variables and secrets
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials.json
secrets.json
secrets/
.streamlit/secrets.toml
**/.streamlit/secrets.toml

# Local logs and temporary files
*.log
logs/
tmp/
temp/
*.tmp
*.bak
*.old
*.cache

# Raw and processed customer data
data/raw/*.csv
data/processed/*.csv
data/database/
data/**/*.db
data/**/*.sqlite
data/**/*.sqlite3

# Trained machine learning artifacts
models/*.joblib
models/*.pkl
models/*.pickle
models/*.onnx
models/best_model_metadata.json

# Customer-level reports
reports/test_predictions.csv
reports/retention/customer_risk_segments.csv
reports/retention/campaign_priorities.csv

# Generated analytics outputs
reports/evaluation_metrics.json
reports/permutation_importance.csv
reports/sql/*.csv

# Local Streamlit state
.streamlit/cache/
.streamlit/logs/

# Preserve folder structure
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/database/.gitkeep
!models/.gitkeep
!reports/.gitkeep
!reports/figures/.gitkeep
!reports/retention/.gitkeep
!reports/sql/.gitkeep
